{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Host=localhost;Database=multihost;Username=multihost;Password=multihost" },
  "Security": {
    "JwtKey": "dev-only-change-me-use-a-long-random-secret-0123456789",
    "Issuer": "multihost-master",
    "AdminTokenMinutes": 60,
    "AgentTokenDays": 365,
    "BootstrapEnrollmentToken": ""
  },
  "Admin": { "Username": "admin", "Password": "" },
  "Monitoring": {
    "Enabled": true,
    "HeartbeatIntervalSeconds": 15,
    "OfflineAfterSeconds": 45,
    "CheckIntervalSeconds": 10,
    "JobTimeoutMinutes": 30,
    "MetricRetentionHours": 24
  },
  "Playbooks": { "Directory": "playbooks" },
  "Swagger": { "Enabled": false }
}
